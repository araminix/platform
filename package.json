{
    "name": "@araminix/platform",
    "description": "Enterprise-grade actor runtime, WebSocket endpoint platform, and agent execution engine",
    "version": "2.2.0",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/araminix/platform.git"
    },
    "bugs": {
        "url": "https://github.com/araminix/platform/issues"
    },
    "homepage": "https://github.com/araminix/platform#readme",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "!dist/tests",
        "README.md",
        "LICENSE"
    ],
    "keywords": [
        "araminix",
        "actor-model",
        "realtime",
        "platform",
        "websocket",
        "agent",
        "worker-threads",
        "express-ws",
        "microservices"
    ],
    "author": "Amin Abbasi",
    "license": "MIT",
    "scripts": {
        "build": "tsc",
        "prepublishOnly": "pnpm run build && pnpm test",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "node --test --test-reporter=./dist/tests/reporter.js \"dist/tests/**/*.test.js\"",
        "test:coverage": "node --experimental-test-coverage --test --test-reporter=./dist/tests/reporter.js \"dist/tests/**/*.test.js\""
    },
    "dependencies": {
        "axios": "1.21.0",
        "cookie-parser": "1.4.7",
        "express": "5.3.0",
        "express-rate-limit": "8.7.1",
        "express-ws": "5.0.2",
        "minio": "8.0.7",
        "multer": "2.5.0"
    },
    "devDependencies": {
        "@araminix/lib": "2.1.1",
        "@trivago/prettier-plugin-sort-imports": "6.0.2",
        "@types/cookie-parser": "1.4.10",
        "@types/express": "5.0.6",
        "@types/express-ws": "3.0.6",
        "@types/multer": "2.3.0",
        "@types/node": "26.6.5",
        "@types/supertest": "7.2.1",
        "@types/ws": "8.18.2",
        "prettier": "3.9.10",
        "supertest": "7.3.1",
        "typescript": "7.0.2"
    }
}
